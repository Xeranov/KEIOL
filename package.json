{
  "name": "keiol",
  "productName": "KEIOL",
  "version": "2.0.0",
  "description": "KEIOL - Modern Desktop Video Player & Anime Streaming Hub",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node src/test/verify_all.js",
    "build": "electron-builder --win",
    "dist": "electron-builder --win",
    "publish": "electron-builder --win -p always"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xeranov/KEIOL.git"
  },
  "keywords": [
    "video-player",
    "electron",
    "anime",
    "streaming",
    "youtube-controls",
    "keiol"
  ],
  "author": "Xeranov",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "hls.js": "^1.7.3"
  },
  "devDependencies": {
    "electron": "^44.7.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.keiol.app",
    "productName": "KEIOL",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.ico",
      "build/icon.png",
      "build/tray-icon.png",
      "package.json",
      "version.json",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**/*",
      "**/node_modules/ffprobe-static/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KEIOL"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Xeranov",
        "repo": "KEIOL"
      }
    ]
  }
}
